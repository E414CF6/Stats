# Vercel 클라우드 배포 시 마인크래프트 플러그인(Serve) 터널/도메인 주소 지정
# 설정 시 Vercel의 /api/* 라우트가 플러그인의 /api/*로 안전하게 프록시 질의합니다.
# REMOTE_API_URL=https://stats-api.your-domain.com

# ==============================================================================
# RSA-SHA256 디지털 서명 인증 설정 (Serve 플러그인 요청 시 필수)
# ==============================================================================
# 1. 파일 경로로 지정할 경우 (기본값: ./keys/private_key.pem 또는 ../Serve/keys/private_key.pem 자동 감지)
# RSA_PRIVATE_KEY_PATH=keys/private_key.pem

# 2. Vercel 환경변수 등에 직접 PEM 문자열로 등록할 경우 (npm run gen-keys 출력값 복사)
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (선택) 레거시 API 키 보호를 함께 사용할 경우
# API_SECRET_KEY=everest-local-api-secret
# REQUIRE_API_KEY=true
